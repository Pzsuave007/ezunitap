{
  "ignorePatterns": [
    "**/build/**",
    "frontend/build/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "env": {
    "browser": true,
    "serviceworker": true,
    "worker": true
  },
  "globals": {
    "WorkerGlobalScope": "readonly",
    "__REACT_DEVTOOLS_GLOBAL_HOOK__": "readonly"
  }
}
