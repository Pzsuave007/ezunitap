RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Proxy /api/* to local FastAPI backend on port 8007
RewriteCond %{REQUEST_URI} ^/api
RewriteRule ^(.*)$ http://127.0.0.1:8007/$1 [P,L]

# Social/link crawlers requesting a digital card (/c/<slug>) get server-rendered
# Open Graph meta tags (person + company), so shared links don't show generic
# Unitap branding. Real users fall through to the SPA below.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|vkShare|SkypeUriPreview|Embedly|Iframely|flipboard|tumblr|bitlybot|Snapchat|Google-InspectionTool) [NC]
RewriteRule ^c/([^/]+)/?$ http://127.0.0.1:8007/api/public/card/$1/og [P,L]

# Social/link crawlers requesting a Google Reviews page (/r/<slug>) get
# server-rendered Open Graph meta tags (business name + info) too.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|vkShare|SkypeUriPreview|Embedly|Iframely|flipboard|tumblr|bitlybot|Snapchat|Google-InspectionTool) [NC]
RewriteRule ^r/([^/]+)/?$ http://127.0.0.1:8007/api/public/reviews/$1/og [P,L]

# SPA fallback — everything else falls back to index.html (React Router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Long cache for hashed static assets
<IfModule mod_expires.c>
    ExpiresActive On
    # index.html / HTML must NEVER be cached — it points to the latest hashed JS/CSS.
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Force-revalidate HTML so a re-deploy is picked up immediately (no stale index.html).
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
