RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Proxy /api/* to local FastAPI backend on port 8007
RewriteCond %{REQUEST_URI} ^/api
RewriteRule ^(.*)$ http://127.0.0.1:8007/$1 [P,L]

# Social/link crawlers requesting a digital card (/c/<slug>) get server-rendered
# Open Graph meta tags (person + company), so shared links don't show generic
# Unitap branding. Real users fall through to the SPA below.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|vkShare|SkypeUriPreview|Embedly|Iframely|flipboard|tumblr|bitlybot|Snapchat|Google-InspectionTool) [NC]
RewriteRule ^c/([^/]+)/?$ http://127.0.0.1:8007/api/public/card/$1/og [P,L]

# Social/link crawlers requesting a Google Reviews page (/r/<slug>) get
# server-rendered Open Graph meta tags (business name + info) too.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|vkShare|SkypeUriPreview|Embedly|Iframely|flipboard|tumblr|bitlybot|Snapchat|Google-InspectionTool) [NC]
RewriteRule ^r/([^/]+)/?$ http://127.0.0.1:8007/api/public/reviews/$1/og [P,L]

# --- AI Search / SEO -------------------------------------------------------
# robots.txt, llms.txt and sitemap.xml are served by the backend (host-aware,
# with absolute URLs) for EVERYONE. These win over any static file.
RewriteRule ^robots\.txt$  http://127.0.0.1:8007/api/robots.txt  [P,L]
RewriteRule ^llms\.txt$    http://127.0.0.1:8007/api/llms.txt     [P,L]
RewriteRule ^sitemap\.xml$ http://127.0.0.1:8007/api/sitemap.xml  [P,L]

# AI/search crawlers (which don't run JavaScript) get server-rendered HTML with
# the real business content + JSON-LD. Real users fall through to the SPA below,
# so this CANNOT affect normal visitors.
# Conversion (Problem) page on a customer's own domain: /p/<slug>
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^p/([^/]+)/?$ http://127.0.0.1:8007/api/ssr/p/$1 [P,L]

# Product/Software detail page on a customer's own domain: /producto/<slug>
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^producto/([^/]+)/?$ http://127.0.0.1:8007/api/ssr/pr/$1 [P,L]

# Tenant conversion page under the platform: /sitio/<slug>/p/<pageslug>
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^sitio/([^/]+)/p/([^/]+)/?$ http://127.0.0.1:8007/api/ssr/pp/$1/$2 [P,L]

# Tenant product page under the platform: /sitio/<slug>/producto/<productslug>
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^sitio/([^/]+)/producto/([^/]+)/?$ http://127.0.0.1:8007/api/ssr/producto/$1/$2 [P,L]

# Tenant site home under the platform: /sitio/<slug>
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^sitio/([^/]+)/?$ http://127.0.0.1:8007/api/ssr/site/$1 [P,L]

# Site HOME: / (and /index.html) for AI/search crawlers.
# NOTE: we do NOT filter by %{HTTP_HOST} here. On cPanel, addon domains share the
# account's vhost and Apache canonicalizes %{HTTP_HOST} (and even %{HTTP:Host}) to
# the account's PRIMARY domain, so a customer addon domain (e.g. uni2mkt.com) is
# indistinguishable from the account domain (e.g. ezunitap.com) at the .htaccess
# level. Instead we proxy ALL bot home hits to the backend, which resolves the
# real site from the forwarded Host header. Hosts with no configured site get the
# normal React SPA shell (HTTP 200) back from the backend — never a 404.
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Applebot|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|anthropic-ai|Google-Extended|CCBot|Amazonbot|DuckDuckBot|YandexBot|meta-externalagent|Google-InspectionTool) [NC]
RewriteRule ^(index\.html)?$ http://127.0.0.1:8007/api/ssr/home [P,L]

# SPA fallback — everything else falls back to index.html (React Router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Long cache for hashed static assets
<IfModule mod_expires.c>
    ExpiresActive On
    # index.html / HTML must NEVER be cached — it points to the latest hashed JS/CSS.
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Force-revalidate HTML so a re-deploy is picked up immediately (no stale index.html).
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
