# Custom-domain EDGE (DigitalOcean droplet). Pure reverse proxy + On-Demand TLS.
# Every customer domain pointing here is proxied to the main UniTech server with
# the Host rewritten, and gets automatic Let's Encrypt SSL. Nothing to sync here.
{
	email admin@ezunitap.com
	on_demand_tls {
		ask https://ezunitap.com/api/public/domain-allowed
		interval 2m
		burst 5
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy https://ezunitap.com {
		header_up Host ezunitap.com
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
	}
}

http:// {
	redir https://{host}{uri} permanent
}
